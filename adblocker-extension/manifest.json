{
  "manifest_version": 3,
  "name": "NovaShield - Pemblokir Iklan",
  "version": "3.8.2",
  "description": "Pemblokir iklan dengan homepage modern, IP Masker, scriptlet injection, HTML filtering, GPC privacy, dan enhanced activation security.",
  "author": "Ahsan Gresik",
  "homepage_url": "https://www.ahsangresik.me",
  "default_locale": "id",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NovaShield",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus",
    "downloads",
    "webNavigation",
    "notifications",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_main",
        "enabled": true,
        "path": "rules/main_rules.json"
      },
      {
        "id": "ruleset_trackers",
        "enabled": true,
        "path": "rules/tracker_rules.json"
      },
      {
        "id": "ruleset_youtube",
        "enabled": true,
        "path": "rules/youtube_rules.json"
      },
      {
        "id": "ruleset_malware",
        "enabled": true,
        "path": "rules/malware_rules.json"
      },
      {
        "id": "ruleset_https",
        "enabled": true,
        "path": "rules/https_upgrade.json"
      },
      {
        "id": "ruleset_popup",
        "enabled": true,
        "path": "rules/popup_rules.json"
      },
      {
        "id": "ruleset_redirect",
        "enabled": true,
        "path": "rules/redirect_rules.json"
      },
      {
        "id": "ruleset_antiadblock",
        "enabled": true,
        "path": "rules/antiadblock_rules.json"
      },
      {
        "id": "ruleset_adscript",
        "enabled": true,
        "path": "rules/adscript_patterns.json"
      },
      {
        "id": "ruleset_gambling",
        "enabled": true,
        "path": "rules/gambling_rules.json"
      },
      {
        "id": "ruleset_adult",
        "enabled": true,
        "path": "rules/adult_rules.json"
      },
      {
        "id": "ruleset_scam",
        "enabled": true,
        "path": "rules/scam_rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "data/cosmetic.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-scriptlets.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-htmlfilter.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-antiadblock.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-privacy.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-userprivacy.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-popup.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-scanner.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-annoyance.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.google.com/*",
        "*://www.google.co.id/*",
        "*://www.google.co.uk/*",
        "*://www.google.de/*",
        "*://www.google.fr/*",
        "*://www.google.co.jp/*",
        "*://www.google.com.au/*",
        "*://www.google.ca/*",
        "*://www.google.co.in/*",
        "*://www.google.com.br/*",
        "*://www.google.com.mx/*",
        "*://www.google.ru/*",
        "*://www.google.it/*",
        "*://www.google.es/*",
        "*://www.google.nl/*",
        "*://www.google.com.sg/*",
        "*://www.google.com.ph/*",
        "*://www.google.com.my/*",
        "*://www.google.co.th/*",
        "*://www.google.com.vn/*",
        "*://www.google.co.kr/*",
        "*://www.google.com.hk/*",
        "*://www.google.com.tw/*",
        "*://www.google.pl/*",
        "*://www.google.se/*",
        "*://www.google.com.tr/*",
        "*://www.google.com.sa/*",
        "*://www.google.com.eg/*",
        "*://www.google.com.ng/*",
        "*://www.google.co.za/*"
      ],
      "js": [
        "content-google-redirect.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-activation.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/cosmetic.css",
        "data/whitelist.json",
        "activation.html",
        "data/redirect-resources.js",
        "data/filter-parser.js",
        "data/dynamic-filtering.js",
        "data/proxy-engine.js",
        "data/activation-security.js",
        "homepage/homepage.html",
        "homepage/homepage.css",
        "homepage/homepage.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "novashield@ahsangresik.me",
      "strict_min_version": "115.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "homepage/homepage.html"
  }
}